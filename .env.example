# Xaverus server-authoritative Safety Passport (on-chain)
XAVERUS_RPC_URL=https://rpc.xlayer.tech
XAVERUS_PASSPORT_CONTRACT=0xeB999d9abE4577987fb393a4BAb5B61531D038e4
# Optional: deployment block to bound Activity log reads
XAVERUS_PASSPORT_DEPLOYMENT_BLOCK=
# Builder Code is attribution only — not the Passport contract
XAVERUS_BUILDER_CODE_CONTRACT=0xd6c426f9c077358735622ae5a83468dc0510823b

# x402 seller (server-only; keep disabled until credentials validated)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
XAVERUS_PAY_TO_ADDRESS=
XAVERUS_X402_PRICE=$0.01
XAVERUS_X402_ENABLED=false
XAVERUS_MODE=demo-safe

# Human-proof minting: X OAuth (server-only)
# Create the X app in the X Developer Portal first:
# docs/X_DEVELOPER_PORTAL_GUIDE.md
# X_CLIENT_ID is the app's public identifier (not a secret).
X_CLIENT_ID=
# X_CLIENT_SECRET is a secret: never commit it, never paste it in chat.
X_CLIENT_SECRET=
# Must match the callback URL registered in the X app exactly.
# Local: http://localhost:3000/api/mint/x/callback
# Production: https://<domain>/api/mint/x/callback
X_REDIRECT_URI=

# Human-proof minting: proof store + factory
# JSON file path for bindings and proofs. When set, proofs survive a server
# restart (file-backed store); when unset, the store is in-memory only.
# Required for anchoring (scripts/anchor-proof.mjs).
XAVERUS_PROOF_STORE_PATH=
# Deployed XaverusPassportFactory address. Without it, /api/mint/passport
# answers allowed:true with transaction:null (gate runs, no on-chain target).
XAVERUS_PASSPORT_FACTORY=

# TapeOut integration (see docs/TAPEOUT_INTEGRATION.md)
# Processor contract + numeric circuit id of the policy circuit. Set both or
# neither: half-configured TapeOut makes the mint route answer 500.
XAVERUS_TAPEOUT_PROCESSOR=
XAVERUS_TAPEOUT_CIRCUIT_ID=
# Container address holding the anchored proof files (proofs/<wallet>.json).
XAVERUS_TAPEOUT_CONTAINER=
# RPC for TapeOut reads. Defaults to https://rpc.xlayer.tech when unset.
XAVERUS_TAPEOUT_RPC_URL=
# JSON-lines file recording every policy-circuit eval (one line per eval:
# proof hash, circuit id, processor, input bits, allow bit, timestamp).
# When unset, evals are kept in memory only and lost on restart.
XAVERUS_TAPEOUT_EVAL_LOG_PATH=
# WARNING: SECRET. The container editor's private key, used only by
# scripts/anchor-proof.mjs --send to broadcast anchor writes. Never commit
# it, never paste it in chat, never put a real key in this file.
XAVERUS_ANCHOR_PRIVATE_KEY=
