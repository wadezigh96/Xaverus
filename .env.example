# Xaverus server-authoritative Safety Passport (on-chain)
XAVERUS_RPC_URL=https://rpc.xlayer.tech
XAVERUS_PASSPORT_CONTRACT=
# Optional: deployment block to bound Activity log reads
XAVERUS_PASSPORT_DEPLOYMENT_BLOCK=
# Builder Code is attribution only — not the Passport contract
XAVERUS_BUILDER_CODE_CONTRACT=0xd6c426f9c077358735622ae5a83468dc0510823b

# x402 seller (server-only; keep disabled until credentials validated)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
XAVERUS_PAY_TO_ADDRESS=
XAVERUS_X402_PRICE=$0.01
XAVERUS_X402_ENABLED=false
# eip155:1952 = X Layer testnet; eip155:196 = X Layer mainnet
XAVERUS_X402_NETWORK=eip155:1952
XAVERUS_MODE=demo-safe
